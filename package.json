{
  "name": "mcrs",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*"
  ],
  "scripts": {
    "gen:modules": "node tools/gen-client-modules.mjs",
    "dev:server": "npm run dev -w @mcrs/server",
    "dev:client": "npm start -w @mcrs/client",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test:ci --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
