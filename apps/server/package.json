    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "@mcrs/core-server": "*",
    "express": "^5.2.1"
  }
